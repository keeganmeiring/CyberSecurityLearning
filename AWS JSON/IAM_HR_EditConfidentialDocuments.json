{
    "Version": "2012-10-17",
    "Statement": [{
        "Sid": "HR_AllowViewDocuments_MFA",
        "Effect": "Allow",
        "Action": [
            "s3:GetObject"
        ],
        "Resource": "arn:aws:s3:::acme-hr-documents/*",
        "Condition": {
            "Bool": {
                "aws:MultiFactorAuthPresent": "true"
            }
        }
    },
        {
         "Sid": "HR_AllowDeleteDocuments_MFA",
        "Effect": "Allow",
        "Action": [
            "s3:DeleteObject"
        ],
        "Resource": "arn:aws:s3:::acme-hr-documents/*",
        "Condition": {
             "Bool": {
                "aws:MultiFactorAuthPresent": "true"
            }    
            }
        },
            {
        "Sid": "HR_DenyDelete_ConfidentialDocuments",
        "Effect": "Deny",
        "Action": [
            "s3:DeleteObject"
        ],
        "Resource": "arn:aws:s3:::acme-hr-documents/*",
        "Condition": {
            "StringEquals": {
                "s3:ExistingObjectTag/Classification": "Confidential"
            }
        }
            }
        ]
}