{
    "Version": "2012-10-17",
    "Statement": [{
        "Sid": "ImageResizerRole",
        "Effect": "Allow",
        "Action": [
            "lambda:InvokeFunction"
        ],
        "Resource": "arn:aws:lambda:us-east-1:123456789012:function:resize-image-function"
            },
        {
        "Sid": "DenyImageFunctionDelete",
        "Effect": "Deny",
        "Action": [
            "lambda:UpdateFunctionCode",
            "lambda:DeleteFunction"
        ],
        "Resource": "arn:aws:lambda:us-east-1:123456789012:function:resize-image-function"
        }]
}