{
    "Version": "2012-10-17",
    "Statement": [{
        "Sid": "DevOpsManageEC2",
        "Effect": "Allow",
        "Action": [
            "ec2:StartInstances",
            "ec2:StopInstances"
        ],
        "Resource": "arn:aws:ec2:us-east-1:123456789012:instance/i-0abc12345def67890"
            },
        {
         "Sid": "DevOpsViewEC2",
        "Effect": "Allow",
        "Action": [
            "ec2:DescribeInstances"
        ],
        "Resource": "*"
            },
        {
         "Sid": "DevOpsDenyDeleteEC2",
        "Effect": "Deny",
        "Action": [
            "ec2:TerminateInstances"
        ],
        "Resource": "arn:aws:ec2:us-east-1:123456789012:instance/i-0abc12345def67890"
            }        
        ]
}