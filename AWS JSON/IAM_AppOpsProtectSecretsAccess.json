{
    "Version": "2012-10-17",
    "Statement": [{
        "Sid": "AppOps_ViewSecretsAll",
        "Effect": "Allow",
        "Action": [
            "secretsmanager:GetSecretValue"
        ],
        "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:*"
    },
        {
         "Sid": "AppOps_DenyMasterPasswordIfUnsecured",
        "Effect": "Deny",
        "Action": [
            "secretsmanager:GetSecretValue"
        ],
        "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/database/master-password",
        "Condition": {
             "NotIpAddress": {
                "aws:SourceIp": "10.0.0.0/16"},
            "Bool": {
                "aws:MultiFactorAuthPresent": "false"}   
        }
    }
    ]
}