{
    "Version": "2012-10-17",
    "Statement": [{
        "Sid": "Marketing_ViewCampaignAssets",
        "Effect": "Allow",
        "Action": [
            "s3:ListBucket"
        ],
        "Resource": "arn:aws:s3:::acme-campaign-assets"
    },
        {
         "Sid": "Marketing_AllowAssetUploads_InternalIP",
        "Effect": "Allow",
        "Action": [
            "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::acme-campaign-assets/*",
        "Condition": {
             "IpAddress": {
                "aws:SourceIp": "10.0.0.0/16"},
            "Bool": {
                "aws:MultiFactorAuthPresent": "true"
            }
        }
        },
            {
        "Sid": "Marketing_ProtectApprovedHeroBanners",
        "Effect": "Deny",
        "Action": [
            "s3:DeleteObject",
            "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::acme-campaign-assets/hero-banners/approved-banners"
       
            }
        ]
}